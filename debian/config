#!/bin/bash
set -e

. /usr/share/debconf/confmodule

# Auto-detect NVIDIA GPU
DETECTED_GPU="No NVIDIA GPU detected"
if command -v nvidia-smi >/dev/null 2>&1; then
    GPU_NAME=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1 || echo "NVIDIA GPU")
    if [ -n "$GPU_NAME" ]; then
        DETECTED_GPU="✓ NVIDIA GPU detected: $GPU_NAME"
        # Default to GPU if NVIDIA detected
        db_set dictator/acceleration-mode "gpu"
    else
        # Default to CPU if no NVIDIA GPU
        db_set dictator/acceleration-mode "cpu"
    fi
else
    # Default to CPU if nvidia-smi not available
    db_set dictator/acceleration-mode "cpu"
fi

# Substitute the detected GPU info into the template
db_subst dictator/acceleration-mode DETECTED_GPU "$DETECTED_GPU"

# Ask the question with high priority
db_input high dictator/acceleration-mode || true
db_go || true

#DEBHELPER#

exit 0
