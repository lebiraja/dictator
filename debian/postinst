#!/bin/bash
set -e

case "$1" in
    configure)
        # Setup uinput permissions
        if ! getent group uinput > /dev/null; then
            groupadd -r uinput
        fi

        # Create udev rule for uinput access
        cat > /etc/udev/rules.d/99-dictator-uinput.rules <<'EOF'
KERNEL=="uinput", GROUP="uinput", MODE="0660", OPTIONS+="static_node=uinput"
EOF

        # Load uinput kernel module now and on boot
        if ! lsmod | grep -q uinput; then
            modprobe uinput || true
        fi
        if [ ! -f /etc/modules-load.d/uinput.conf ]; then
            echo "uinput" > /etc/modules-load.d/uinput.conf
        fi

        # Reload udev rules
        udevadm control --reload-rules || true
        udevadm trigger || true

        echo ""
        echo "========================================="
        echo "Dictator installed!"
        echo "========================================="
        echo ""
        echo "To complete setup, as your normal user:"
        echo ""
        echo "1. Add yourself to the uinput group:"
        echo "   sudo usermod -aG uinput \$USER"
        echo ""
        echo "2. Run the per-user setup (creates the Python environment):"
        echo "   dictator-setup"
        echo ""
        echo "3. Log out and log back in"
        echo ""
        echo "4. Press Shift+Ctrl+Space to dictate"
        echo ""
        echo "Optional GPU acceleration (NVIDIA):"
        echo "   ~/.local/share/dictator/venv/bin/pip install nvidia-cublas-cu12 nvidia-cudnn-cu12"
        echo ""
    ;;
esac

#DEBHELPER#

exit 0
